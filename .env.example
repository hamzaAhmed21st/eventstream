# Local-only PostgreSQL defaults. Replace these outside local development.
POSTGRES_USER=eventstream
POSTGRES_PASSWORD=eventstream
POSTGRES_DB=eventstream
POSTGRES_PORT=5432

# Host-side application connections. Directly run Python processes load these
# from .env. Compose constructs internal URLs with the `postgres` and `redis`
# service names instead of using these host URLs.
DATABASE_URL=postgresql+psycopg://eventstream:eventstream@localhost:5432/eventstream
REDIS_URL=redis://localhost:6379/0
# Make does not import .env. Export/pass TEST_* in the shell or use
# `make test-backend TEST_DATABASE_URL=... TEST_REDIS_URL=...` to override.
TEST_DATABASE_URL=postgresql+psycopg://eventstream:eventstream@localhost:5432/eventstream_test
TEST_REDIS_URL=redis://localhost:6379/15

# Ports published only on the local host by Docker Compose.
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173

# Redis Stream topology.
REDIS_STREAM=eventstream:events
REDIS_CONSUMER_GROUP=eventstream-workers
# Blank uses the worker container or host name; set an explicit stable instance ID if preferred.
REDIS_CONSUMER_NAME=

# Comma-separated browser origins and shared API/worker runtime settings.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Leave blank for the production frontend image. Nginx proxies same-origin
# /api and /health requests to the Compose API service.
VITE_API_BASE_URL=
